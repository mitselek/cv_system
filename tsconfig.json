{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./scripts/**/*.ts", "./knowledge_base/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".venv",
    "venv",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "htmlcov",
    "job-monitoring",
    "email-monitor",
    "applications"
  ]
}