{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start EdgeDB",
      "type": "shell",
      "command": "docker compose up -d edgedb",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Stop EdgeDB",
      "type": "shell",
      "command": "docker compose stop edgedb",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Restart EdgeDB",
      "type": "shell",
      "command": "docker compose restart edgedb",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Test MCP Knowledge Base",
      "type": "shell",
      "command": "npm",
      "args": ["test", "--", "--run"],
      "options": {
        "cwd": "${workspaceFolder}/mcp-servers/knowledge-base"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Type Check MCP Knowledge Base",
      "type": "shell",
      "command": "npm",
      "args": ["run", "type-check"],
      "options": {
        "cwd": "${workspaceFolder}/mcp-servers/knowledge-base"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
