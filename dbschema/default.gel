module default {
    # Shared types across domains
    scalar type Status extending enum<
        draft,
        ready,
        submitted,
        interview,
        offer,
        accepted,
        rejected,
        withdrawn
    >;

    scalar type EventType extending enum<
        interview,
        deadline,
        followup,
        meeting,
        other
    >;

    scalar type EventStatus extending enum<
        scheduled,
        completed,
        cancelled,
        rescheduled
    >;

    scalar type CorrespondenceDirection extending enum<
        incoming,
        outgoing
    >;

    scalar type Language extending enum<en, et>;

    # Knowledge Base Domain - Scalar Types
    scalar type Translation extending json {
        constraint expression on (
            len(<str>__subject__['et'] ?? '') > 0 OR
            len(<str>__subject__['en'] ?? '') > 0
        ) {
            errmessage := 'At least one language (et or en) must be provided';
        };
    }

    scalar type HttpUrl extending str {
        constraint regexp(r'^https?://[^\s]+$') {
            errmessage := 'Invalid HTTP/HTTPS URL format';
        };
    }

    scalar type IsoDate extending str {
        constraint regexp(r'^\d{4}(-\d{2}(-\d{2})?)?$') {
            errmessage := 'Date must be in YYYY, YYYY-MM, or YYYY-MM-DD format';
        };
    }

    scalar type VerificationStatus extending enum<
        verified,
        draft,
        outdated
    >;

    scalar type ProjectStatus extending enum<
        active,
        completed,
        archived
    >;

    scalar type SkillCategory extending enum<
        programming_language,
        backend_development,
        frontend_development,
        database,
        devops,
        cloud_platform,
        framework,
        tool,
        methodology,
        soft_skill,
        domain_knowledge,
        testing,
        security,
        other
    >;

    scalar type LanguageProficiency extending json;

    # Applications Domain
    type Company {
        required property name -> str {
            constraint exclusive;
        }
        property notes -> str;
        property created -> datetime {
            default := datetime_current();
        }

        multi link postings := .<company[is Posting];
    }

    type Posting {
        required link company -> Company;
        required property url -> str {
            constraint exclusive;
        }
        required property title -> str;
        property location -> str;
        property posted_date -> str;
        property discovered_date -> datetime {
            default := datetime_current();
        }
        property deadline -> datetime;
        property status -> str;
        property fit_score -> int16;
        property notes -> str;

        multi link applications := .<posting[is Application];
        multi link correspondence := .<context[is Correspondence];
        multi link events := .<context[is Event];
    }

    type Application {
        required link posting -> Posting;
        required property status -> Status {
            default := Status.draft;
        }
        property created_date -> datetime {
            default := datetime_current();
        }
        property submitted_date -> datetime;
        property fit_score -> int16;
        property notes -> str;

        # Documents stored as JSON: {cv_et?: string, cv_en?: string, letter_et?: string, letter_en?: string}
        property documents -> json;

        multi link correspondence := .<context[is Correspondence];
        multi link events := .<context[is Event];
    }

    abstract type ContextualEntity {
        # Polymorphic reference - can point to Company, Posting, or Application
        link context -> Object;
    }

    type Correspondence extending ContextualEntity {
        required property direction -> CorrespondenceDirection;
        required property date -> datetime;
        property subject -> str;
        required property body -> str;
        property from_address -> str;
        property to_address -> str;
        property email_file -> str;
    }

    type Event extending ContextualEntity {
        required property type -> EventType;
        required property datetime -> datetime;
        property location -> str;
        property notes -> str;
        property status -> EventStatus {
            default := EventStatus.scheduled;
        }
        link rescheduled_from -> Event;
        property rescheduled_reason -> str;
    }

    # Knowledge Base Domain - Entity Types
    type Tag {
        required property name -> str;
        required property category -> str;
        required property last_verified -> IsoDate;
        property created -> datetime {
            default := datetime_current();
        }

        constraint exclusive on ((.name, .category));

        # Computed backlinks
        multi link experiences := .<tags[is Experience];
        multi link skills := .<tags[is Skill];
        multi link achievements := .<tags[is Achievement];
        multi link projects := .<tags[is Project];
        multi link certifications := .<tags[is Certification];
        multi link education_entries := .<tags[is Education];
        multi link languages := .<tags[is KnowledgeBaseLanguage];
        multi link hobbies := .<tags[is Hobby];
    }

    type Skill {
        required property external_id -> str {
            constraint exclusive;
        }
        required property name -> Translation;
        required property category -> SkillCategory;
        required property level -> int16 {
            constraint min_value(1);
            constraint max_value(10);
        }
        property level_display -> str;  # e.g., "9/10"
        property article -> Translation;
        required property verification_status -> VerificationStatus {
            default := VerificationStatus.draft;
        }
        required property last_verified -> IsoDate;
        property created -> datetime {
            default := datetime_current();
        }

        multi link tags -> Tag;

        # Computed backlinks
        multi link demonstrated_in := .<skills_demonstrated[is Experience];
        multi link used_in_projects := .<skills_demonstrated[is Project];
    }

    type Project {
        required property external_id -> str {
            constraint exclusive;
        }
        required property name -> Translation;
        property url -> HttpUrl;
        property repository -> HttpUrl;
        required property status -> ProjectStatus {
            default := ProjectStatus.active;
        }
        property dates -> tuple<`start`: IsoDate, `end`: IsoDate>;
        property technologies -> array<str>;
        property article -> Translation;
        required property verification_status -> VerificationStatus {
            default := VerificationStatus.draft;
        }
        required property last_verified -> IsoDate;
        property created -> datetime {
            default := datetime_current();
        }

        multi link tags -> Tag;
        multi link skills_demonstrated -> Skill;
    }

    type Experience {
        required property external_id -> str {
            constraint exclusive;
        }
        required property title -> Translation;
        required property company -> Translation;
        property url -> HttpUrl;
        required property dates -> tuple<`start`: IsoDate, `end`: IsoDate>;
        property article -> Translation;
        required property verification_status -> VerificationStatus {
            default := VerificationStatus.draft;
        }
        required property last_verified -> IsoDate;
        property created -> datetime {
            default := datetime_current();
        }

        multi link tags -> Tag;
        multi link skills_demonstrated -> Skill;

        # Computed backlink
        multi link achievements := .<parent_experience[is Achievement];
    }

    type Achievement {
        required property external_id -> str {
            constraint exclusive;
        }
        required property title -> Translation;
        required property date -> IsoDate;
        property article -> Translation;
        required property verification_status -> VerificationStatus {
            default := VerificationStatus.draft;
        }
        required property last_verified -> IsoDate;
        property created -> datetime {
            default := datetime_current();
        }

        multi link tags -> Tag;
        link parent_experience -> Experience;
    }

    type Certification {
        required property external_id -> str {
            constraint exclusive;
        }
        required property title -> Translation;
        required property issuer -> Translation;
        required property date -> IsoDate;
        property expiry_date -> IsoDate;
        property credential_id -> str;
        property credential_url -> HttpUrl;
        property article -> Translation;
        required property verification_status -> VerificationStatus {
            default := VerificationStatus.draft;
        }
        required property last_verified -> IsoDate;
        property created -> datetime {
            default := datetime_current();
        }

        multi link tags -> Tag;
    }

    type Education {
        required property external_id -> str {
            constraint exclusive;
        }
        required property institutions -> array<Translation>;
        required property fields -> array<Translation>;
        required property dates -> tuple<`start`: IsoDate, `end`: IsoDate>;
        property degree -> Translation;
        property article -> Translation;
        required property verification_status -> VerificationStatus {
            default := VerificationStatus.draft;
        }
        required property last_verified -> IsoDate;
        property created -> datetime {
            default := datetime_current();
        }

        multi link tags -> Tag;
    }

    type KnowledgeBaseLanguage {
        required property external_id -> str {
            constraint exclusive;
        }
        required property name -> Translation;
        required property proficiency -> LanguageProficiency;
        property article -> Translation;
        required property verification_status -> VerificationStatus {
            default := VerificationStatus.draft;
        }
        required property last_verified -> IsoDate;
        property created -> datetime {
            default := datetime_current();
        }

        multi link tags -> Tag;
        multi link evidence -> Experience;  # Where this language was used
    }

    type Hobby {
        required property external_id -> str {
            constraint exclusive;
        }
        required property name -> Translation;
        property tools -> array<str>;
        property article -> Translation;
        required property verification_status -> VerificationStatus {
            default := VerificationStatus.draft;
        }
        required property last_verified -> IsoDate;
        property created -> datetime {
            default := datetime_current();
        }

        multi link tags -> Tag;
    }
}
